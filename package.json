{
  "name": "tlc-travel-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --filter=@tlc/web",
    "build": "turbo run build",
    "prepare:ci": "pnpm --filter @tlc/shared build && pnpm --filter @tlc/ai-core build && pnpm --filter @tlc/integrations build && node apps/functions/scripts/vendor-shared.mjs && pnpm install --offline --filter @tlc/functions... --frozen-lockfile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "emulators": "firebase emulators:start",
    "seed": "pnpm --filter @tlc/functions seed",
    "ai:seed": "node scripts/seed-synthetic.mjs",
    "marketing:seed": "node scripts/seed-marketing.mjs",
    "content:seed": "node --experimental-strip-types --env-file=.env scripts/seed-content.mjs --apply",
    "docs:data-model": "pnpm --filter @tlc/shared docs:data-model",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tlc-holidays --non-interactive \"pnpm --filter @tlc/web test:rules\"",
    "admin:set-role": "node --env-file=.env scripts/set-admin-role.mjs",
    "admin:send-password-setup": "node --env-file=.env scripts/send-password-setup.mjs"
  },
  "devDependencies": {
    "firebase-tools": "^15.28.2",
    "prettier": "^3.9.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
