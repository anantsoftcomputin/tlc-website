# Copy nonsecret values into .env.<firebase-project-id>. Store secrets in Secret Manager.
TLC_ORG_ID=tlc-vacations
TLC_SITE_URL=
WHATSAPP_ENABLED=false
EMAIL_ENABLED=false
MARKETING_EMAIL_FROM=
EMAIL_REPLY_TO=
TLC_AI_PROVIDER=tlc
TLC_AI_BASE_URL=
TLC_AI_MODEL=
TLC_AI_STRUCTURED_OUTPUT=on
TLC_AI_AUTH_REQUIRED=false
# Required Secret Manager names when WhatsApp is enabled:
# WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN
# Required Secret Manager names when email is enabled:
# RESEND_API_KEY, RESEND_WEBHOOK_SECRET
# If TLC_AI_AUTH_REQUIRED=true: TLC_AI_API_KEY

# Enable new enquiry, captured-payment, confirmed-booking and issued-document emails after provider validation.
EMAIL_LIFECYCLE_ENABLED=false

# Attach TBO search secrets to WhatsApp bot/recovery workers after configuring approved supplier access.
WHATSAPP_LIVE_SEARCH_ENABLED=false
# When true, Secret Manager: TBO_API_USERNAME, TBO_API_PASSWORD, TBO_STATIC_USERNAME, TBO_STATIC_PASSWORD.
# Also configure TBO_ENV, TBO_CLIENT_ID, TBO_END_USER_IP and every issued production TBO_*_URL.
# Organization integration settings and approved personalization pricing/rates apply to both channels.
