{
  "name": "@tlc/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare:deploy": "pnpm --filter @tlc/shared build && pnpm --filter @tlc/ai-core build && pnpm --filter @tlc/integrations build && node scripts/vendor-shared.mjs && pnpm install --offline --filter @tlc/functions... && pnpm build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "seed": "node src/seed.mjs"
  },
  "dependencies": {
    "@tlc/shared": "file:vendor/shared",
    "@tlc/ai-core": "file:vendor/ai-core",
    "@tlc/integrations": "file:vendor/integrations",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
