# Server-only model and messaging configuration
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# Configure actual model pricing in INR per million tokens; leave empty to report unpriced usage.
OPENAI_INPUT_INR_PER_MILLION=
OPENAI_OUTPUT_INR_PER_MILLION=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=
MARKETING_EMAIL_FROM=
# Required for production public requests and callable functions. Production builds
# (Netlify CONTEXT=production or TLC_DEPLOY_ENV=production) fail without it unless
# APP_CHECK_ENFORCEMENT=off. Set the same APP_CHECK_ENFORCEMENT value for Functions.
NEXT_PUBLIC_APP_CHECK_SITE_KEY=
# required | off | (empty: enforce in production when a site key is set)
APP_CHECK_ENFORCEMENT=
# Prefer pnpm dev:local for a credential-free emulator configuration.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# TBO (Tek Travels) flights and hotels. Leave empty to keep TBO disabled.
# Agency API login from TBO (used for hotel search/prebook/book and air Authenticate).
TBO_ENV=staging
TBO_API_USERNAME=
TBO_API_PASSWORD=
TBO_CLIENT_ID=ApiIntegrationNew
# Static hotel content login. On staging TBO publishes a shared test account in its
# Authorization doc page; production uses the login TBO issues at certification.
TBO_STATIC_USERNAME=
TBO_STATIC_PASSWORD=
# Server's public IP, sent as EndUserIp on every TBO call (TBO whitelists it in production).
TBO_END_USER_IP=
# Production only: TBO issues these hosts at certification. Staging uses documented defaults.
TBO_AUTH_URL=
TBO_AIR_URL=
TBO_HOTEL_SEARCH_URL=
TBO_HOTEL_PREBOOK_URL=
TBO_HOTEL_BOOK_URL=
TBO_HOTEL_BOOKING_DETAIL_URL=
TBO_HOTEL_CHANGE_REQUEST_URL=
TBO_STATIC_URL=
