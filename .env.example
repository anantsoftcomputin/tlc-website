NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TLC_ORG_ID=tlc-vacations
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=918948888873
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
EMAIL_PROVIDER_API_KEY=
AI_PROVIDER_API_KEY=
PUBLIC_SITE_URL=http://localhost:3000
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com/hotel-api/1.0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ZOHO_BOOKS_ACCESS_TOKEN=
ZOHO_BOOKS_ORGANIZATION_ID=
TALLY_ENDPOINT=
TALLY_COMPANY=
ACCOUNTING_PROVIDER_COST_PER_CALL=0
PAYMENT_PROVIDER_COST_PER_CALL=0

# Server-only model and messaging configuration
# TLC inference is the default. OpenAI requires an explicit provider selection.
TLC_AI_PROVIDER=tlc
# Include /v1; localhost HTTP is allowed for laptop development. Remote endpoints require HTTPS.
TLC_AI_BASE_URL=
TLC_AI_MODEL=
TLC_AI_API_KEY=
# Functions secret binding for authenticated model endpoints.
TLC_AI_AUTH_REQUIRED=false
# Use off for MLX servers without JSON-schema decoding; outputs are still validated.
TLC_AI_STRUCTURED_OUTPUT=on
TLC_AI_INPUT_INR_PER_MILLION=
TLC_AI_OUTPUT_INR_PER_MILLION=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# Configure actual model pricing in INR per million tokens; leave empty to report unpriced usage.
OPENAI_INPUT_INR_PER_MILLION=
OPENAI_OUTPUT_INR_PER_MILLION=
# Functions: enable a channel only after adding its Google Secret Manager secrets.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MARKETING_EMAIL_FROM=
EMAIL_REPLY_TO=
# Public HTTPS website origin for one-click unsubscribe links.
TLC_SITE_URL=
# Required for production public requests and callable functions. Production builds
# (Netlify CONTEXT=production or TLC_DEPLOY_ENV=production) fail without it unless
# APP_CHECK_ENFORCEMENT=off. Set the same APP_CHECK_ENFORCEMENT value for Functions.
NEXT_PUBLIC_APP_CHECK_SITE_KEY=
# required | off | (empty: enforce in production when a site key is set)
APP_CHECK_ENFORCEMENT=
# Prefer pnpm dev:local for a credential-free emulator configuration.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# TBO (Tek Travels) flights and hotels. Leave empty to keep TBO disabled.
# Agency API login from TBO (used for hotel search/prebook/book and air Authenticate).
TBO_ENV=staging
TBO_API_USERNAME=
TBO_API_PASSWORD=
TBO_CLIENT_ID=ApiIntegrationNew
# Static hotel content login. On staging TBO publishes a shared test account in its
# Authorization doc page; production uses the login TBO issues at certification.
TBO_STATIC_USERNAME=
TBO_STATIC_PASSWORD=
# Server's public IP, sent as EndUserIp on every TBO call (TBO whitelists it in production).
TBO_END_USER_IP=
# Production only: TBO issues these hosts at certification. Staging uses documented defaults.
TBO_AUTH_URL=
TBO_AIR_URL=
TBO_HOTEL_SEARCH_URL=
TBO_HOTEL_PREBOOK_URL=
TBO_HOTEL_BOOK_URL=
TBO_HOTEL_BOOKING_DETAIL_URL=
TBO_HOTEL_CHANGE_REQUEST_URL=
TBO_STATIC_URL=
