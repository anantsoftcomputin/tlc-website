rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function contentStaff(orgId) { return request.auth != null && request.auth.token.orgId == orgId && request.auth.token.role in ['super_admin', 'owner', 'manager', 'admin', 'marketing', 'content_editor']; }
    // Media uploads and audit records are owned by the authenticated server command.
    match /media/public/{allPaths=**} { allow read: if true; allow write: if false; }
    match /media/private/{orgId}/{allPaths=**} { allow read: if contentStaff(orgId); allow write: if false; }
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId && request.resource.size < 10 * 1024 * 1024;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
